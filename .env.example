NEXT_PUBLIC_CONTACT_EMAIL="kontakt@milodo-medical.de"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PORTAL_URL="https://app.milodo-medical.de"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_PRIVACY_LAST_UPDATED="2026-05-09"

# Legal/DSGVO pages (fill before launch)
# NEXT_PUBLIC_COMPANY_NAME="Milodo Medical Group"
# NEXT_PUBLIC_COMPANY_LEGAL_FORM=""
# NEXT_PUBLIC_COMPANY_ADDRESS="Straße Hausnr.\nPLZ Ort\nDeutschland"
# NEXT_PUBLIC_COMPANY_PHONE=""
# NEXT_PUBLIC_COMPANY_REPRESENTATIVE=""
# NEXT_PUBLIC_COMPANY_REGISTER="" # z.B. "HRB 12345, Amtsgericht Dortmund"
# NEXT_PUBLIC_COMPANY_VAT_ID=""   # z.B. "DE123456789"
# NEXT_PUBLIC_COMPANY_SUPERVISORY_AUTHORITY="" # falls reglementiert
# NEXT_PUBLIC_DPO_CONTACT=""      # optional

# Blog export location (same structure as milodo-app writes on publish)
# If you use SFTP, keep BLOG_EXPORT_DIR empty and set BLOG_SFTP_* instead.
# BLOG_EXPORT_DIR="/absolute/path/to/data/blog"

# Optional: read blog exports via SFTP (recommended when "we work with FTP")
# Important: no leading spaces before variable names.
# BLOG_SFTP_HOST=""
# BLOG_SFTP_PORT="22"
# BLOG_SFTP_USER=""
# BLOG_SFTP_PASSWORD=""
# BLOG_SFTP_BASE_PATH="/path/on/server/to/data"   # contains blog/...

# Optional: enable diagnostics endpoint `/api/blog/diag` (require token)
# BLOG_DIAG_TOKEN=""
